# Copy to .env (gitignored) and fill in. PROWLARR_API_KEY is shared with
# Findr: enter the same value under Settings → Services → Prowlarr API key.

# User and group that own files the containers write (`id -u`, `id -g`)
PUID=1000
PGID=1000
TZ=Etc/UTC

# Where container state lives (databases, config files); relative to this folder
CONFIG_ROOT=./config

# Interface the web UIs listen on. 127.0.0.1 keeps them private to this machine;
# use 0.0.0.0 to reach them from other devices (behind a firewall or VPN).
BIND_ADDRESS=127.0.0.1

# ---------- Findr ---------- #
FINDR_PORT=34571
# Torrent port. Must match Settings -> Torrent client in Findr (default 6881)
TORRENT_PORT=6881
# Host folder holding your library and downloads; enter paths inside it under
# Settings -> Library paths (it is mounted at the same path in the container)
MEDIA_ROOT=/srv/media

# ---------- Prowlarr ---------- #
PROWLARR_PORT=9696
# Shared with Findr (Settings → Services → Prowlarr API key). Generate with: openssl rand -hex 16
PROWLARR_API_KEY=replace_with_a_random_32_char_hex_key

# ---------- Image tags ---------- #
# Pin to specific versions for reproducible installs
FINDR_TAG=latest
PROWLARR_TAG=latest
FLARESOLVERR_TAG=latest
