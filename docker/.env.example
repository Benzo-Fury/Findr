# Optional. Every value below is already the default in compose.yml; copy this
# file to .env (gitignored) only to change one.

# User and group that own files the containers write (`id -u`, `id -g`)
PUID=1000
PGID=1000
TZ=Etc/UTC

# Where container state lives (databases, config files); relative to this folder
CONFIG_ROOT=./config

# Interface the web UIs listen on. 127.0.0.1 keeps them private to this machine;
# use 0.0.0.0 to reach them from other devices (behind a firewall or VPN).
BIND_ADDRESS=127.0.0.1

# ---------- Findr ---------- #
FINDR_PORT=34571
# Torrent port. Must match Settings -> Torrent client in Findr (default 6881)
TORRENT_PORT=6881
# Host folder for your library and downloads, mounted at /media in Findr.
# Findr files films in /media/movies and shows in /media/tv, and works on
# downloads in /media/downloads; change those under Settings -> Library paths.
MEDIA_ROOT=./media

# ---------- Prowlarr ---------- #
PROWLARR_PORT=9696

# ---------- Image tags ---------- #
# Pin to specific versions for reproducible installs
FINDR_TAG=latest
PROWLARR_TAG=latest
FLARESOLVERR_TAG=latest
