NODE_ENV=development
PORT=3030
DATABASE_PATH=data/findr.db
BASE_URL=http://localhost:3030

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_a_long_random_string

# Honour X-Forwarded-For for rate limiting and the remote access check
# (only behind a trusted proxy)
TRUST_PROXY=false

# Everything else — API keys, the Prowlarr URL, the torrent port, remote
# access — is set on the Settings page. A fresh install signs in as
# admin / admin from this machine and must then choose real credentials.
