NODE_ENV=development
PORT=3030
DATABASE_PATH=findr.db
BASE_URL=http://localhost:3030

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_a_long_random_string

# First admin account, created on startup when no users exist
FINDR_ADMIN_EMAIL=admin@example.com
FINDR_ADMIN_PASSWORD=change_me_please

# Honour X-Forwarded-For for rate limiting (only behind a trusted proxy)
TRUST_PROXY=false

TMDB_API_KEY=your_tmdb_api_key_here

# Prowlarr instance used to search indexers for torrents
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# qBittorrent Web UI
QBT_URL=http://localhost:8080
QBT_USERNAME=admin
QBT_PASSWORD=changeme

# Optional: enables the LLM relevance filter
ANTHROPIC_API_KEY=
