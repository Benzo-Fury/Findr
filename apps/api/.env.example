# Nothing here is required: Findr starts without a .env. It serves on port
# 34571 (Settings → Access) and generates its session signing secret into
# data/auth.secret, beside the database, on first run.

DATABASE_PATH=data/findr.db

# Overrides the port from Settings → Access, e.g. when that port is taken
# PORT=34571

# Honour X-Forwarded-For for rate limiting and the remote access check
# (only behind a trusted proxy)
TRUST_PROXY=false

# Everything else — API keys, the Prowlarr URL, the ports, remote access —
# is set on the Settings page. A fresh install signs in as admin / admin
# from this machine and must then choose real credentials.
